# Copiar como .env en la raíz del proyecto. Nunca subir claves reales a Git.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=control_rrhh
PORT=3100
FACEVISION_URL=http://127.0.0.1:8007
# Producción: generar 32 bytes aleatorios, codificados hex (64 caracteres).
# BIOMETRIC_KEY=
# Alternativa Docker: archivo con 32 bytes o 64 caracteres hex.
# BIOMETRIC_KEY_FILE=/run/secrets/biometric_key
# Sólo dentro del contenedor se escucha 0.0.0.0; el default nativo sigue loopback.
# HTTP_HOST=0.0.0.0
# MONGO_HOST=mongo
# MONGO_USER=controlrrhh
# MONGO_PASSWORD_FILE=/run/secrets/mongo_app
# HTTPS LAN requiere certificado confiable en la tablet:
# TLS_CERT=C:/ruta/server.pem
# TLS_KEY=C:/ruta/server-key.pem
# HTTPS_PORT=3444
# LAN_HOST=0.0.0.0
